<UserControl x:Class="UltimateWindowsOptimizer.App.Views.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Updates" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <!-- Current / Latest -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Current Version" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtCurrentVersion" Text="1.0.0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Latest Version" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtLatestVersion" Text="—" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="TxtStatus" Text="" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Button Style="{StaticResource PrimaryButton}" Content="Check for Updates" Click="Check_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnUpdateNow" Style="{StaticResource PrimaryButton}" Content="Update Now"
                    Background="{StaticResource SuccessBrush}" Click="UpdateNow_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button x:Name="BtnRemind" Content="Remind Me Later" Click="Remind_Click" Visibility="Collapsed" Padding="12,8"/>
        </StackPanel>

        <!-- Channel -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Update Channel" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox x:Name="CmbChannel" Width="200" HorizontalAlignment="Left" SelectionChanged="Channel_Changed">
                    <ComboBoxItem Content="Stable" IsSelected="True"/>
                    <ComboBoxItem Content="Beta"/>
                    <ComboBoxItem Content="Nightly"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Settings -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Settings" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkAutoCheck" Content="Automatically check for updates" IsChecked="True" Margin="0,4"/>
                <CheckBox x:Name="ChkNotify" Content="Notify about updates" IsChecked="True" Margin="0,4"/>
                <CheckBox x:Name="ChkAutoDownload" Content="Automatically download updates" IsChecked="False" Margin="0,4"/>
                <CheckBox x:Name="ChkAutoInstall" Content="Automatically install updates" IsChecked="False" Margin="0,4"/>
                <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
            </StackPanel>
        </Border>

        <!-- History -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Update History" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" Width="80"/>
                                <TextBlock Text="{Binding Status}" Width="100" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding InstalledAt, StringFormat='{}{0:dd.MM.yyyy'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Release notes panel -->
        <Border x:Name="NotesPanel" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="What's New" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtReleaseNotes" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
