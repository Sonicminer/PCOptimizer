<UserControl x:Class="UltimateWindowsOptimizer.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Change History" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <ItemsControl x:Name="HistoryList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding TweakName}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Result}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
