<UserControl x:Class="UltimateWindowsOptimizer.App.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <!-- Metric cards -->
        <UniformGrid Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtCpu" Text="-- %" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="RAM" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtRam" Text="-- %" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="Disk" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtDisk" Text="-- %" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Uptime" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtUptime" Text="--" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <Button Style="{StaticResource PrimaryButton}" Content="🔍  PC analysieren" Click="Analyze_Click" Margin="0,0,12,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="✨  1-Klick-Optimierung" Click="OneClick_Click" Margin="0,0,12,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="📋  Empfohlene Optimierungen" Click="Recommendations_Click"/>
        </StackPanel>

        <!-- Recommendations panel -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="System Analysis &amp; Recommendations" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <TextBlock x:Name="TxtAnalysis" Text="Click „PC analysieren“ to start." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ItemsControl x:Name="LstRecommendations" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
