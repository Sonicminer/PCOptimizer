<Window x:Class="UltimateWindowsOptimizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultimate Windows Optimizer"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12">
                    <TextBlock Text="Ultimate" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Windows Optimizer" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <Button Style="{StaticResource NavButton}" Content="📊  Dashboard" Tag="Dashboard" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚡  Smart Optimizer" Tag="Optimizer" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🎮  Gaming Center" Tag="Gaming" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🚀  Performance" Tag="Performance" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🌐  Network" Tag="Network" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🧹  Cleaner" Tag="Cleaner" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="💾  Storage" Tag="Storage" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🖥️  Hardware" Tag="Hardware" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="📈  Monitoring" Tag="Monitoring" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🏁  Benchmark" Tag="Benchmark" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🪟  Windows Tweaks" Tag="Windows" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🔒  Privacy" Tag="Privacy" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="📦  Debloat" Tag="Debloat" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙️  Services" Tag="Services" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="▶️  Startup" Tag="Startup" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="📋  Processes" Tag="Processes" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🔧  Drivers" Tag="Drivers" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🛠️  Repair" Tag="Repair" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="🔋  Power" Tag="Power" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="👤  Profiles" Tag="Profiles" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="💾  Backups" Tag="Backups" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="📜  History" Tag="History" Click="Nav_Click"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙️  Settings" Tag="Settings" Click="Nav_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPcName" Text="PC" FontWeight="SemiBold" FontSize="15" Margin="0,0,16,0"/>
                        <TextBlock x:Name="TxtWindowsVersion" Text="Windows" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Health " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtHealthScore" Text="--" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Perf " Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock x:Name="TxtPerfScore" Text="--" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Content="🔄 Restore Last" Click="RestoreLast_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="🚨 Emergency Reset" Background="{StaticResource DangerBrush}" Click="EmergencyReset_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content host -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <ContentControl x:Name="ContentHost"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
